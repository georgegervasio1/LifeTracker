# Copy to .env for local dev. NEVER commit .env.
# In production these come from Cloud Run env vars / Secret Manager.

PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox            # sandbox | production

# Only this Google account may use the API
ALLOWED_EMAIL=you@example.com

# Your GitHub Pages origin (for CORS)
FRONTEND_ORIGIN=https://georgegervasio1.github.io

# Local dev only: set to 1 to skip Firebase auth checks
DEV_SKIP_AUTH=0
