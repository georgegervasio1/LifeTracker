rules_version = '2';
// LifeTracker: the browser never talks to Firestore. Every read and write goes through the Cloud Run
// backend, which uses the Admin SDK (rules don't apply to it) and checks the signed-in user itself.
// So the client SDK and REST API get nothing, even with the public Firebase web config.
// Deploy: Firebase console -> Firestore Database -> Rules, paste this, Publish (or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
